# Server
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=default
LOG_LEVEL=INFO

# Quantum backends
QUANTUM_EXECUTION_MODE=LOCAL
QUANTUM_PYTHON_EXEC=/opt/venv/bin/python
QUANTUM_EXPLAIN_SHOTS=2048
QUANTUM_EXPLAIN_SEED=42
QUANTUM_LOCAL_MAX_NOISE=0.1

# Optional experimental local Oracle Lab (no IBM credentials needed)
QUANTUM_ORACLE_ENABLED=true
QUANTUM_ORACLE_MAX_WIDTH=8
QUANTUM_ORACLE_MAX_TOTAL_QUBITS=16
QUANTUM_ORACLE_MAX_SHOTS=8192
QUANTUM_ORACLE_MAX_ITERATIONS=32
QUANTUM_ORACLE_TIMEOUT_SECONDS=30
QUANTUM_ORACLE_CONCURRENCY=2
QUANTUM_ORACLE_CACHE_ENTRIES=64
QUANTUM_ORACLE_CACHE_DIR=/app/oracle-cache

# IBM (optional)
# IBM_QUANTUM_API_TOKEN=
# IBM_QUANTUM_BACKEND=ibm_nairobi
